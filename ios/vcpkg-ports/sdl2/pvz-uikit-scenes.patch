+// Bounded keyboard-request probes; no text contents or private device data.
+static void PVZTraceKeyboardRequest(const char *phase, UITextField *field,
+                                   BOOL wasVisible, BOOL attempted, BOOL accepted)
+{
+    static unsigned int budget = 16;
+    UIWindow *host = field.window;
+    if (budget == 0) return;
+    --budget;
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                "PVZKeyboard[r5]: unix=%.3f tick=%u phase=%s was_visible=%d window=%d scene=%d scene_state=%ld key=%d first=%d attempted=%d accepted=%d",
+                NSDate.date.timeIntervalSince1970, SDL_GetTicks(), phase, wasVisible,
+                host != nil, host.windowScene != nil,
+                host.windowScene ? (long)host.windowScene.activationState : -1L,
+                host.isKeyWindow, field.isFirstResponder, attempted, accepted);
+}
 
