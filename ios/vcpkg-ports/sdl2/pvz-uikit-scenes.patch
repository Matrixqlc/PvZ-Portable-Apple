+// PvZ local SDL2 adaptation: use the owning scene, never a process-wide orientation.
+#if !TARGET_OS_TV
+UIInterfaceOrientation UIKit_GetSceneOrientation(UIScreen *screen)
+{
+    UIWindowScene *fallback = nil;
+    for (UIScene *candidate in UIApplication.sharedApplication.connectedScenes) {
+        UIWindowScene *scene = (UIWindowScene *)candidate;
+        if (![candidate isKindOfClass:UIWindowScene.class]) continue;
+        if (scene.screen != screen) continue;
+        if (scene.activationState == UISceneActivationStateForegroundActive) {
+            return scene.effectiveGeometry.interfaceOrientation;
+        }
+        if (scene.activationState == UISceneActivationStateForegroundInactive || !fallback) fallback = scene;
+    }
+    return fallback ? fallback.effectiveGeometry.interfaceOrientation : UIInterfaceOrientationUnknown;
+}
+#endif
